{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    ':timezone(Europe/Paris)',
    ':label(renovate)',
    ':semanticPrefixFix',
    ':automergePr',
    ':automergeStableNonMajor',
    ':automergeDigest',
  ],
  platformAutomerge: true,
  gitIgnoredAuthors: [
    '4999573+homelab-workbench-bump[bot]@users.noreply.github.com',
  ],
  minimumReleaseAge: '2 days',
  gomod: {
    postUpdateOptions: [
      'gomodTidy',
      'gomodUpdateImportPaths',
    ],
  },
  dependencyDashboard: {
    title: '🤖 Renovate Dashboard',
  },
  commitMessageTopic: '{{depName}}',
  commitMessageExtra: 'to {{newVersion}}',
  commitMessageSuffix: '',
  ignorePaths: [
    'k8s-apps/archive/**',
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)Chart\\.yaml$/',
      ],
      matchStrings: [
        'repository: git\\+https://github.com/(?<packageName>[^@\\s]+)@(?:[^?\\s]+)\\?ref=(?<currentValue>[^\\s]+)\\s+version: (?<currentVersion>[^\\s]+)',
      ],
      datasourceTemplate: 'github-tags',
    },
  ],
  packageRules: [
    {
      matchManagers: [
        'gomod',
      ],
      matchUpdateTypes: [
        'major',
      ],
      dependencyDashboardApproval: true,
    },
    {
      matchPackageNames: [
        'github.com/chromedp/cdproto',
      ],
      matchManagers: [
        'gomod',
      ],
      dependencyDashboardApproval: true,
    },
    {
      matchManagers: [
        'helmv3',
      ],
      matchPackageNames: [
        'local-path-provisioner',
      ],
      enabled: false,
    },
    {
      matchPackageNames: [
        'velero/velero-plugin-for-aws',
      ],
      enabled: false,
    },
    {
      matchPackageNames: [
        '/^registry\\.snow-delta\\.ts\\.net\\//',
      ],
      enabled: false,
    },
    {
      matchDatasources: [
        'helm',
      ],
      commitMessageTopic: 'chart {{depName}}',
    },
    {
      matchDatasources: [
        'docker',
      ],
      commitMessageTopic: 'image {{depName}}',
    },
    {
      versioning: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<revision>\\d+)-ls(?<build>\\d+)$',
      matchPackageNames: [
        '/^lscr.io\\/linuxserver\\//',
      ],
    },
    {
      versioning: 'regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-ls(?<build>\\d+)$',
      matchPackageNames: [
        '/^lscr.io\\/linuxserver\\/bazarr/',
      ],
    },
    {
      versioning: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?(?:ubu\\d+)-ls(?<build>\\d+)$',
      matchPackageNames: [
        '/^lscr.io\\/linuxserver\\/jellyfin/',
      ],
    },
    {
      versioning: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:-r\\d+|_v\\d+(?:\\.\\d+)*)-ls(?<build>\\d+)$',
      matchPackageNames: [
        '/^lscr.io\\/linuxserver\\/qbittorrent/',
      ],
    },
    {
      matchPackageNames: [
        'garage',
      ],
      matchDatasources: [
        'helm',
      ],
      overrideDatasource: 'custom.garage',
      registryUrls: [
        'https://git.deuxfleurs.fr/Deuxfleurs/garage/raw/branch/main/script/helm/garage/Chart.yaml',
      ],
    },
    {
      versioning: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?-(?<compatibility>apache|nginx)(?:-alpine)?-(?<build>\\d+)$',
      matchPackageNames: [
        '/modsecurity-crs/',
      ],
    },
    {
      matchPackageNames: [
        '/ghcr.io\\/dgtlmoon\\/changedetection.io/',
        '/otel\\/opentelemetry-collector-contrib/',
        '/opentelemetry-operator/',
        '/opentelemetry-collector/',
        '/ghcr.io\\/gtsteffaniak\\/filebrowser/',
        '/qtap/',
        'mendhak/http-https-echo',
        'slskd/slskd',
        '/valkey/',
      ],
      automerge: true,
    },
  ],
  customDatasources: {
    garage: {
      format: 'yaml',
      transformTemplates: [
        '{"releases":[{"version": $.version}]}',
      ],
    },
  },
}
