# Keep the flake tool shell from the repo root active here.
source_up

# terraform shim: value changes in secrets.yaml are invisible to terraform
# (vault_kv_secret_v2 data_json_wo is write-only), so the shim injects
# -replace for secrets whose Vault payload differs from the file. Live
# comparison against Vault - no snapshots to maintain.
# Plain terraform / tf / tfa keep working as-is.
PATH_add bin

bin/terraform tfs-status || true
