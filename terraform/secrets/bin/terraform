#!/usr/bin/env bash
# terraform wrapper (secrets module).
#
# vault_kv_secret_v2 uses a write-only data_json_wo attribute, so terraform
# cannot diff the sops file against Vault: value changes never show up in a
# plan and normally require an explicit terraform taint / -replace.
#
# This wrapper forwards every command to the real terraform untouched, plus:
#   - apply/plan injects "-replace=<addr>" for every secret whose Vault
#     payload differs from secrets.yaml (live comparison, no snapshots)
#   - the "tfs-status" pseudo-subcommand prints the drift summary
#     (used by .envrc to report on entering the directory)
#
# Vault address comes from providers.tf, token from $VAULT_TOKEN or
# ~/.vault-token - the same sources the terraform provider uses.
#
# Loaded by .envrc via PATH_add bin; only active inside terraform/secrets.

set -euo pipefail

selfdir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
rootdir="$(cd "$selfdir/.." && pwd -P)"

# ---- drift detection (secrets.yaml vs live Vault) ----

mount=kvv2
resource='vault_kv_secret_v2.secrets'
addr=$(sed -n 's/.*address *= *"\(.*\)".*/\1/p' "$rootdir/providers.tf" 2>/dev/null | head -1)
token=${VAULT_TOKEN:-$(cat "$HOME/.vault-token" 2>/dev/null || true)}
export TFS_ADDR=$addr TFS_TOKEN=$token TFS_MOUNT=$mount

file_tmp=$(mktemp "${TMPDIR:-/tmp}/tfs.XXXXXX")
vault_tmp=$(mktemp "${TMPDIR:-/tmp}/tfs.XXXXXX")
trap 'rm -f "$file_tmp" "$vault_tmp"' EXIT

# Sorted "<path> <base64-of-canonical-payload>" lines for the decrypted file.
# Canonical payload = JSON of the secret's key/value pairs, keys sorted,
# values stringified - the same normalization is applied to Vault responses,
# and base64 keeps the value free of tabs/newlines/backslashes so the
# line format stays unambiguous.
_file_hashes() {
  sops -d --output-type json "$rootdir/secrets.yaml" \
    | jq -r 'to_entries[] | .key as $app | .value | to_entries[] |
        "\($app)/\(.key) \(.value | with_entries(.value |= tostring)
                         | to_entries | sort_by(.key) | from_entries
                         | tojson | @base64)"' \
    | sort
}

# "<path> <base64>" for one path as currently stored in Vault.
# No output (only a warning) if the path is absent or unreadable; terraform
# will surface the real error if Vault is actually down.
# Note: runs via xargs in a fresh bash, so it must not rely on the parent's
# set -o pipefail - hence the explicit two-step fetch/parse.
_vault_hash() {
  local path=$1 resp payload
  if ! resp=$(VAULT_TOKEN=$TFS_TOKEN vault kv get -address="$TFS_ADDR" \
      -format=json "$TFS_MOUNT/$path" 2>/dev/null); then
    echo "tfs: could not read $path from Vault" >&2
    return 0
  fi
  payload=$(jq -r '.data.data | with_entries(.value |= tostring)
                   | to_entries | sort_by(.key) | from_entries
                   | tojson | @base64' <<<"$resp" 2>/dev/null)
  [[ -n $payload ]] && printf '%s %s\n' "$path" "$payload"
}
export -f _vault_hash

# Fill $1 with file hashes, $2 with Vault hashes (parallel reads).
_collect() {
  _file_hashes > "$1"
  if [[ -s $1 ]]; then
    cut -d' ' -f1 "$1" | xargs -P 8 -n 1 bash -c '_vault_hash "$1"' _ | sort > "$2"
  fi
}

# Paths present on both sides with different payloads.
_changed() {
  join "$1" "$2" | awk '$2 != $3 {print $1}'
}

# Abort loudly if anything the drift detection needs is missing - a silent
# skip here would mean a plan/apply that quietly misses value changes.
_check_deps() {
  local dep missing=()
  for dep in sops jq vault; do
    command -v "$dep" >/dev/null 2>&1 || missing+=("$dep")
  done
  if (( ${#missing[@]} )); then
    echo "tfs: missing dependencies: ${missing[*]} (needed for secret drift detection)" >&2
    exit 127
  fi
  [[ -n $addr ]] || { echo "tfs: no vault address found in $rootdir/providers.tf" >&2; exit 127; }
  [[ -n $token ]] || { echo "tfs: no Vault token available (set VAULT_TOKEN or create ~/.vault-token)" >&2; exit 127; }
}

cmd_status() {
  _collect "$file_tmp" "$vault_tmp"
  local changed new
  changed=$(_changed "$file_tmp" "$vault_tmp")
  new=$(join -v 1 "$file_tmp" "$vault_tmp" | cut -d' ' -f1)
  if [[ -z $changed && -z $new ]]; then
    echo "tfs: secrets.yaml matches Vault"
    return 0
  fi
  [[ -n $changed ]] && printf 'changed:  %s\n' $changed
  [[ -n $new ]] && printf 'new:      %s\n' $new
  echo "tfs: next terraform apply/plan will pick up the changes"
}

cmd_changed() {
  _collect "$file_tmp" "$vault_tmp"
  local path
  while IFS= read -r path; do
    printf -- '-replace=%s["%s"]\n' "$resource" "$path"
    echo "tfs: replacing $path" >&2
  done < <(_changed "$file_tmp" "$vault_tmp")
}

# ---- terraform forwarding ----

# Resolve the real terraform: first hit on PATH that is not this directory.
real=""
while IFS= read -r cand; do
  p="$(cd "$(dirname "$cand")" && pwd -P)"
  if [[ $p != "$selfdir" ]]; then
    real="$cand"
    break
  fi
done < <(type -ap terraform)

if [[ -z $real ]]; then
  echo "tfs: no real terraform found on PATH" >&2
  exit 127
fi

if [[ $# -eq 0 ]]; then
  exec "$real"
fi

cmd="$1"
shift

case $cmd in
  tfs-status)
    _check_deps
    cmd_status
    ;;
  taint)
    for a in "$@"; do
      if [[ $a == *vault_kv_secret_v2.secrets\[* ]]; then
        echo "tfs: refusing to taint '$a' - it is unnecessary." >&2
        echo "tfs: this shim injects -replace for every secret whose payload" >&2
        echo "tfs: differs between secrets.yaml and Vault (live compare)." >&2
        echo "tfs: just edit secrets.yaml and run terraform apply." >&2
        echo "tfs: to force it anyway: $real taint $a" >&2
        exit 1
      fi
    done
    exec "$real" "$cmd" "$@"
    ;;
  apply | plan)
    inject=()
    skip=0
    for a in "$@"; do
      if [[ $a == -destroy* ]]; then
        skip=1
      fi
    done
    if (( ! skip )); then
      _check_deps
      while IFS= read -r line; do
        inject+=("$line")
      done < <(cmd_changed)
    fi
    if (( ${#inject[@]} )); then
      "$real" "$cmd" "${inject[@]}" "$@"
    else
      "$real" "$cmd" "$@"
    fi
    ;;
  *)
    exec "$real" "$cmd" "$@"
    ;;
esac
