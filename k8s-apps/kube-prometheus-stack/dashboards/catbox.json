                "tooltip": {
                  "mode": "single",
                  "sort": "none"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "bytes",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      },
                      {
                        "value": 107374182400,
                        "color": "dark-red"
                      }
                    ]
                  },
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "drawStyle": "line",
                    "gradientMode": "none",
                    "thresholdsStyle": {
                      "mode": "dashed"
                    },
                    "lineWidth": 1,
                    "lineInterpolation": "linear",
                    "fillOpacity": 10,
                    "showPoints": "auto"
                  }
                },
                "overrides": []
              }
            }
          }
        }
