            }
          }
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Spool bytes",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
