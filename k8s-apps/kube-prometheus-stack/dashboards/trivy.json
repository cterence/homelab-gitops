                  "spec": {
                    "options": {
                      "excludeByName": {
                        "Time": true
                      },
                      "indexByName": {
                        "image_repository": 2,
                        "image_tag": 3,
                        "namespace": 0,
                        "resource_name": 1,
                        "value": 4
                      },
                      "renameByName": {
                        "Value": "critical",
