                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "smartctl_device_smart_status",
                        "instant": false,
                        "legendFormat": "SMART status",
                        "range": true
                      }
